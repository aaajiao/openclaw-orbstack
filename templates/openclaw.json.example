{
  // ============================================================================
  // OpenClaw 完整配置模板 (JSON5 格式 - 支持注释和尾随逗号)
  // 
  // 官方文档: https://docs.openclaw.ai/gateway/configuration
  // 
  // 使用说明:
  //   1. 复制此文件到 ~/.openclaw/openclaw.json (VM 内)
  //   2. 填入你的 API Key 和聊天平台凭据
  //   3. 根据需要调整其他配置
  //   4. 运行 openclaw-restart 重启服务
  //
  // 配置优先级:
  //   1. 运行时指令 (/model, /elevated, /verbose 等)
  //   2. 特定 Agent 配置 (agents.list[].*)
  //   3. 全局默认值 (agents.defaults.*)
  //   4. 内置默认值
  //
  // 多文件配置 (可选):
  //   $include: "./channels.json"                    // 引用单个文件
  //   $include: ["./agents.json", "./channels.json"] // 引用多个文件
  //   支持嵌套引用，最多 10 层
  // ============================================================================

  // --------------------------------------------------------------------------
  // 一、身份设置 (可选但推荐)
  // --------------------------------------------------------------------------
  identity: {
    name: "OpenClaw",           // 机器人名称
    theme: "helpful assistant", // 性格主题
    emoji: "🦞"                 // 代表 emoji (用于 ack 反应)
  },

  // --------------------------------------------------------------------------
  // 二、环境变量 (可选)
  // --------------------------------------------------------------------------
  env: {
    // 直接设置环境变量 (不覆盖已存在的)
    // OPENROUTER_API_KEY: "sk-or-xxxxx",
    
    // vars 块中的变量
    vars: {
      // GROQ_API_KEY: "gsk-xxxxx"
    },
    
    // 从 shell 环境导入 (可选)
    shellEnv: {
      enabled: false,
      timeoutMs: 15000
    }
  },

  // --------------------------------------------------------------------------
  // 三、认证配置 (API Key / OAuth)
  // --------------------------------------------------------------------------
  auth: {
    // 认证配置文件元数据 (实际密钥存储在 auth-profiles.json)
    profiles: {
      // Anthropic Claude (推荐)
      // OAuth 模式 (Claude Pro/Max 订阅)
      // "anthropic:me@example.com": {
      //   provider: "anthropic",
      //   mode: "oauth",
      //   email: "me@example.com"
      // },
      
      // API Key 模式
      "anthropic:api": {
        provider: "anthropic",
        mode: "api_key"
      },
      
      // OpenAI
      "openai:default": {
        provider: "openai",
        mode: "api_key"
      },
      
      // Google Gemini
      "google:default": {
        provider: "google",
        mode: "api_key"
      }
    },
    
    // 提供商使用顺序 (用于故障转移/负载均衡)
    order: {
      anthropic: ["anthropic:api"],
      openai: ["openai:default"],
      google: ["google:default"]
    }
  },

  // --------------------------------------------------------------------------
  // 四、Agent 运行时配置
  // --------------------------------------------------------------------------
  agents: {
    // 所有 Agent 的默认配置
    defaults: {
      // 工作区目录
      workspace: "~/.openclaw/workspace",
      
      // 用户时区
      userTimezone: "Asia/Shanghai",
      
      // 模型配置
      model: {
        // 主模型 (格式: 提供商/模型名)
        primary: "anthropic/claude-sonnet-4-5",
        // 备用模型 (主模型失败时使用)
        fallbacks: ["anthropic/claude-haiku-4-5", "openai/gpt-5.1-codex"]
      },

      // 图像模型 (可选)
      // imageModel: {
      //   primary: "openai/dall-e-3"
      // },
      
      // 模型别名 (可选)
      // Anthropic 1M 上下文 Beta (可选，Opus 4.6 / Sonnet 4.6 / 4.5 / 4)
      // 在模型条目中添加 params: { context1m: true } 启用
      // 超过 200K token 按 premium pricing 计费 (输入 2x，输出 1.5x)
      // 需要 Usage Tier 4+
      models: {
        "anthropic/claude-opus-4-6": { alias: "opus" },
        // "anthropic/claude-opus-4-6": { alias: "opus", params: { context1m: true } },
        "anthropic/claude-sonnet-4-6": { alias: "sonnet46" },
        "anthropic/claude-sonnet-4-5": { alias: "sonnet" },
        "anthropic/claude-haiku-4-5": { alias: "haiku" }
      },
      
      // 默认思考级别: "off" | "low" | "high"
      thinkingDefault: "low",
      
      // 默认详细模式: "off" | "on"
      verboseDefault: "off",
      
      // 默认提权模式: "off" | "on"
      elevatedDefault: "on",
      
      // 超时时间 (秒)
      timeoutSeconds: 600,
      
      // 媒体文件大小限制 (MB)
      mediaMaxMb: 5,
      
      // 打字指示器间隔 (秒)
      typingIntervalSeconds: 5,
      
      // 最大并发任务数
      maxConcurrent: 3,
      
      // 人类延迟模拟
      humanDelay: {
        mode: "natural"  // "off" | "natural" | "fixed"
      },
      
      // 块流式传输配置
      blockStreamingDefault: "off",  // "off" | "on"
      blockStreamingBreak: "text_end",
      blockStreamingChunk: {
        minChars: 800,
        maxChars: 1200,
        breakPreference: "paragraph"  // "paragraph" | "newline" | "sentence"
      },
      
      // ========== 记忆搜索配置 ==========
      // 重要：Memory Search 需要 embedding API 才能工作！
      // 必须在 ~/.openclaw/agents/<agentId>/agent/auth-profiles.json 中配置
      // OpenAI 或 Google 的 API key，否则索引无法创建。
      // 
      // 配置步骤：
      // 1. 编辑 auth-profiles.json，在 profiles 中添加 "openai:default" 或 "google:default"
      // 2. 运行 openclaw memory status --deep 验证配置
      // 3. 运行 openclaw memory index 构建索引
      //
      // 详见 docs/configuration-guide.md 和 docs/troubleshooting.md
      memorySearch: {
        provider: "auto",  // "auto" | "openai" | "gemini" | "local"
        // auto 模式会按顺序尝试: local → openai → gemini
        // 如果没有可用的 embedding provider，memory search 会被静默禁用
        
        // model: "text-embedding-3-small",  // OpenAI embedding 模型
        // extraPaths: ["../team-docs", "/srv/shared-notes"],  // 额外索引路径
        
        // Batch API 配置 (默认开启，便宜 50% 但较慢)
        // remote: {
        //   batch: {
        //     enabled: true,   // 设为 false 使用实时 API (快但贵)
        //     concurrency: 2
        //   }
        // }
      },
      
      // ========== 沙箱配置 ==========
      // 重要概念:
      // - AI 大脑运行在云端 (Anthropic/OpenAI/Google)，不在沙箱里
      // - 沙箱是 AI 的"手"——只执行工具，不运行 AI
      // - 运行时有两个沙箱容器:
      //   1. sandbox.docker  → 代码执行沙箱 (exec, read, write, edit)
      //   2. sandbox.browser → 浏览器沙箱 (Playwright, Chromium)
      // - 构建时有三个 Docker 镜像:
      //   1. openclaw-sandbox:bookworm-slim        → 基础镜像 (构建依赖)
      //   2. openclaw-sandbox-common:bookworm-slim  → 基于 1 + 开发工具 (代码执行用)
      //   3. openclaw-sandbox-browser:bookworm-slim → 独立构建 (浏览器用)
      sandbox: {
        // 沙箱模式:
        //   "off"      - 不使用沙箱 (危险：AI 可访问 /mnt/mac)
        //   "non-main" - 非主会话使用沙箱 (main session 无法用 sandbox browser)
        //   "all"      - 所有会话都使用沙箱 (推荐：所有功能可用)
        mode: "all",
        
        // 隔离范围:
        //   "session" - 每个会话独立容器
        //   "agent"   - 每个 Agent 独立容器
        //   "shared"  - 共享容器
        scope: "agent",
        
        // 工作区访问权限:
        //   "none" - 无访问权限
        //   "ro"   - 只读
        //   "rw"   - 读写
        workspaceAccess: "rw",
        
        // 沙箱工作区根目录
        workspaceRoot: "~/.openclaw/sandboxes",
        
        // ===== 代码执行沙箱配置 (sandbox.docker) =====
        // 注意: 配置名是 "docker" 但这是"代码执行沙箱"的配置，不是通用 Docker 配置
        docker: {
          // 沙箱镜像
          image: "openclaw-sandbox-common:bookworm-slim",
          // 容器名称前缀
          containerPrefix: "openclaw-sbx-",
          // 工作目录
          workdir: "/workspace",
          // 根文件系统只读
          readOnlyRoot: true,
          // tmpfs 挂载点 (/tmp 需要 exec 权限让 Playwright 能执行)
          tmpfs: ["/tmp:exec,mode=1777", "/var/tmp", "/run"],
          // 网络模式:
          //   "none"   - 无网络 (代码执行最安全，但浏览器无法上网)
          //   "bridge" - 桥接网络 (推荐：浏览器可上网，Docker 仍隔离 Mac 文件系统)
          //   "host"   - 主机网络
          network: "bridge",
          // 运行用户 (macOS 默认用户是 501:501，需要匹配 workspace 权限)
          user: "501:501",
          // 放弃的 Linux capabilities
          capDrop: ["ALL"],
          // 环境变量 (传递给沙箱容器)
          // 重要: API Key 必须在这里配置才能在沙箱内使用！
          // 顶层 env 块的变量不会自动传递到沙箱容器
          // 注意: TELEGRAM_BOT_TOKEN、DISCORD_BOT_TOKEN 等被 Gateway 保留，
          //       需改名为 TG_BOT_TOKEN、DISCORD_TOKEN 才能传到沙箱
          env: {
            LANG: "C.UTF-8",
            // OPENCLAW_GATEWAY_TOKEN 由 Gateway 自动注入，通常不需要手动配置
            // 添加你需要在沙箱内使用的 API Key:
            // 可以用 ${VAR} 引用 .env 文件中的变量，也可以直接填值
            // OPENAI_API_KEY: "${OPENAI_API_KEY}",
            // ANTHROPIC_API_KEY: "${ANTHROPIC_API_KEY}",
            // GOOGLE_API_KEY: "${GOOGLE_API_KEY}",
            // TG_BOT_TOKEN: "${TG_BOT_TOKEN}"  // 用 TG_BOT_TOKEN 而非 TELEGRAM_BOT_TOKEN
          },
          // 资源限制
          pidsLimit: 256,        // 最大进程数
          memory: "1g",          // 内存限制
          memorySwap: "2g",      // 内存+交换限制
          cpus: 1,               // CPU 限制
          ulimits: {
            nofile: { soft: 1024, hard: 2048 },
            nproc: 256
          }
          // 可选配置:
          // setupCommand: "apt-get update && apt-get install -y git",
          // dns: ["1.1.1.1", "8.8.8.8"],
          // extraHosts: ["myhost:192.168.1.1"]
        },
        
        // ===== 浏览器沙箱配置 (sandbox.browser) =====
        browser: {
          enabled: true,
          image: "openclaw-sandbox-browser:bookworm-slim",
          headless: true,
          autoStart: true,              // 自动启动浏览器沙箱
          autoStartTimeoutMs: 30000,    // 启动超时 30 秒
          allowHostControl: true,       // 允许 target="host" 访问宿主浏览器
          // 浏览器沙箱环境变量 (可选，通常不需要配置)
          // OPENCLAW_GATEWAY_TOKEN 由 Gateway 自动注入
          // env: {
          //   LANG: "C.UTF-8",
          //   OPENAI_API_KEY: "sk-xxx"  // 如果浏览器沙箱需要 API Key
          // }
        },
        
        // 自动清理
        prune: {
          idleHours: 24,   // 空闲多久后清理
          maxAgeDays: 7    // 最大存活天数
        }
      }
    },
    
    // 特定 Agent 配置列表 (覆盖默认值)
    list: [
      // 示例: 个人 Agent (完全访问)
      // {
      //   id: "personal",
      //   default: true,
      //   name: "个人助手",
      //   workspace: "~/.openclaw/workspace-personal",
      //   model: { primary: "anthropic/claude-opus-4-6" },
      //   sandbox: { mode: "off" }
      // },
      
      // 示例: 公共 Agent (受限访问)
      // {
      //   id: "public",
      //   name: "公共助手",
      //   workspace: "~/.openclaw/workspace-public",
      //   model: { primary: "anthropic/claude-haiku-4-5" },
      //   sandbox: {
      //     mode: "all",
      //     scope: "session",
      //     workspaceAccess: "none",
      //     docker: { network: "none" }
      //   },
      //   tools: {
      //     deny: ["exec", "write", "edit", "apply_patch", "browser"]
      //   }
      // }
    ]
  },

  // --------------------------------------------------------------------------
  // 五、聊天频道配置
  // --------------------------------------------------------------------------
  channels: {
    // ========== WhatsApp ==========
    whatsapp: {
      // DM 策略:
      //   "pairing"   - 需要配对码 (推荐)
      //   "allowlist" - 仅允许列表中的用户
      //   "open"      - 允许所有人 (需要 allowFrom 包含 "*")
      //   "disabled"  - 禁用 DM
      dmPolicy: "pairing",
      
      // DM 允许列表 (E.164 格式: +国家码手机号)
      allowFrom: [
        // "+8613800138000"
      ],
      
      // 群组策略: "open" | "allowlist" | "disabled"
      groupPolicy: "allowlist",
      
      // 群组允许列表
      groupAllowFrom: [
        // "+8613800138000"
      ],
      
      // 群组设置
      groups: {
        // 所有群组的默认设置
        "*": {
          requireMention: true  // 需要 @mention 才回复
        }
        // 特定群组设置
        // "120363403215116621@g.us": {
        //   requireMention: false,
        //   allowFrom: ["@admin"]
        // }
      },
      
      // 是否发送已读回执 (蓝勾)
      sendReadReceipts: true,
      
      // 媒体大小限制 (MB)
      mediaMaxMb: 50,
      
      // 消息分块限制 (字符)
      textChunkLimit: 4000,
      
      // 分块模式: "length" | "newline"
      chunkMode: "length"
      
      // 多账户配置 (可选)
      // accounts: {
      //   default: {},
      //   business: {}
      // }
    },
    
    // ========== Telegram ==========
    telegram: {
      enabled: false,  // 改为 true 启用
      
      // Bot Token (从 @BotFather 获取)
      // 或设置环境变量 TELEGRAM_BOT_TOKEN
      botToken: "",
      
      // DM 策略
      dmPolicy: "pairing",
      
      // DM 允许列表 (Telegram 用户 ID 或用户名)
      allowFrom: [
        // "123456789",
        // "@username"
      ],
      
      // 群组策略
      groupPolicy: "allowlist",
      groupAllowFrom: [],
      
      // 群组设置
      groups: {
        "*": { requireMention: true }
        // "-1001234567890": {
        //   requireMention: false,
        //   allowFrom: ["@admin"],
        //   systemPrompt: "保持回答简洁",
        //   topics: {
        //     "99": {
        //       requireMention: false,
        //       skills: ["search"]
        //     }
        //   }
        // }
      },
      
      // 历史消息上下文数量
      historyLimit: 50,
      
      // 回复模式: "off" | "first" | "all"
      replyToMode: "first",
      
      // 链接预览
      linkPreview: true,
      
      // 流式传输模式: "off" | "partial" | "block"
      streamMode: "partial",

      // 内联按钮样式: "primary" | "success" | "danger" (可选)
      // buttonStyle: "primary",

      // 用户消息反应作为系统事件 (默认开启)
      // surfaceReactions: true,
      
      // 媒体大小限制 (MB)
      mediaMaxMb: 5,
      
      // 自定义命令
      // 注意: 不要重复内置命令 (new, status, stop, model, usage, think, subagents 等)
      // 内置命令由 Gateway 自动注册，重复声明会导致启动报错
      customCommands: [
        // { command: "backup", description: "Git 备份" },
        // { command: "image", description: "生成图片" }
      ]
      
      // 代理设置 (可选)
      // proxy: "socks5://localhost:9050"
      
      // Webhook 模式 (可选)
      // webhookUrl: "https://example.com/telegram-webhook",
      // webhookSecret: "secret"
    },
    
    // ========== Discord ==========
    discord: {
      enabled: false,  // 改为 true 启用
      
      // Bot Token (从 Discord Developer Portal 获取)
      // 或设置环境变量 DISCORD_BOT_TOKEN
      token: "",
      
      // 媒体大小限制 (MB)
      mediaMaxMb: 8,
      
      // 是否允许其他机器人的消息
      allowBots: false,
      
      // DM 设置
      dm: {
        enabled: true,
        policy: "pairing",  // "pairing" | "allowlist" | "open" | "disabled"
        allowFrom: [
          // "123456789012345678",  // 用户 ID
          // "username"             // 用户名
        ],
        groupEnabled: false,  // 群组 DM
        groupChannels: []
      },
      
      // 服务器设置
      guilds: {
        // "123456789012345678": {
        //   slug: "my-server",
        //   requireMention: false,
        //   reactionNotifications: "own",
        //   users: ["987654321098765432"],
        //   channels: {
        //     "general": { allow: true },
        //     "help": {
        //       allow: true,
        //       requireMention: true,
        //       users: ["987654321098765432"],
        //       skills: ["docs"]
        //     }
        //   }
        // }
      },
      
      // 历史消息上下文数量
      historyLimit: 20,
      
      // 回复模式
      replyToMode: "off",
      
      // 消息分块限制
      textChunkLimit: 2000,
      maxLinesPerMessage: 17,
      
      // 动作权限
      actions: {
        reactions: true,
        stickers: true,
        polls: true,
        messages: true,
        threads: true,
        pins: true,
        search: true,
        memberInfo: true,
        roleInfo: true,
        channelInfo: true,
        voiceStatus: true,
        events: true,
        permissions: true,
        roles: false,      // 危险操作默认关闭
        moderation: false  // 危险操作默认关闭
      },

      // 可复用交互组件
      // components: { reusable: true },

      // 原生 /exec 命令 (带自动补全)
      // exec: { enabled: true }
    },
    
    // ========== Slack ==========
    slack: {
      enabled: false,  // 改为 true 启用
      
      // Bot Token (xoxb-...)
      botToken: "",
      
      // App Token (xapp-...)
      appToken: "",
      
      // 频道设置
      channels: {
        // "#general": { allow: true, requireMention: true }
      },
      
      // DM 设置
      dm: {
        enabled: true,
        allowFrom: [
          // "U123456789"  // Slack 用户 ID
        ]
      },
      
      // 斜杠命令
      slashCommand: {
        enabled: true,
        name: "openclaw",
        sessionPrefix: "slack:slash",
        ephemeral: true
      },

      // 消息流式传输模式: "off" | "native" | "draft"
      // native 使用 Slack 原生单消息流 (chat.startStream/appendStream/stopStream)
      streamMode: "off"
    },
    
    // ========== Google Chat ==========
    googlechat: {
      enabled: false
      // 通过 openclaw channels add --channel googlechat 配置
    },

    // ========== Signal ==========
    signal: {
      enabled: false
      // 手机号 (E.164 格式)
      // number: "+8613800138000"
    },

    // ========== BlueBubbles (推荐替代 iMessage legacy) ==========
    bluebubbles: {
      enabled: false
      // 支持编辑、反应、群管理等完整功能
      // 通过 openclaw channels add --channel bluebubbles 配置
    },

    // ========== iMessage legacy (不推荐，建议用 BlueBubbles) ==========
    imessage: {
      enabled: false
    }

    // ========== 插件频道 (需要 openclaw plugins install) ==========
    // 支持: Feishu (飞书), Mattermost, Microsoft Teams, LINE,
    //       Nextcloud Talk, Matrix, Nostr, Tlon, Twitch, Zalo
    // 通过 openclaw plugins list 查看可用插件
  },

  // --------------------------------------------------------------------------
  // 六、工具权限配置
  // --------------------------------------------------------------------------
  tools: {
    // 沙箱工具权限 (仅在沙箱模式下生效)
    sandbox: {
      tools: {
        // 允许的工具组:
        //   group:runtime  = exec, bash, process
        //   group:fs       = read, write, edit, apply_patch
        //   group:sessions = sessions_list, sessions_history, sessions_send, sessions_spawn, session_status
        //   group:ui       = browser, canvas
        allow: ["group:runtime", "group:fs", "group:sessions", "group:ui"],
        // 禁止的工具 (会覆盖 allow，包括 group:ui 中的 canvas)
        deny: ["canvas", "nodes", "cron", "gateway", "telegram", "whatsapp", "discord", "googlechat", "slack", "signal", "imessage"]
      }
    },
    
    // Web 工具 URL 白名单 (可选)
    // webSearch: { allowedUrls: ["*.example.com"] },
    // webFetch: { allowedUrls: ["*.example.com"] },

    // 执行工具配置
    exec: {
      backgroundMs: 10000,      // 后台执行阈值 (毫秒)
      timeoutSec: 1800,         // 超时时间 (秒)
      cleanupMs: 1800000        // 清理时间 (毫秒)
    },
    
    // 提权配置 (允许危险操作)
    elevated: {
      enabled: true,
      // 各频道的提权用户列表
      allowFrom: {
        whatsapp: [
          // "+8613800138000"
        ],
        telegram: [
          // "123456789"
        ],
        discord: [
          // "username"
        ],
        slack: [
          // "U123"
        ]
      }
    },
    
    // 媒体处理配置
    media: {
      // 音频处理
      audio: {
        enabled: true,
        maxBytes: 20971520,  // 20MB
        models: [
          { provider: "openai", model: "gpt-4o-mini-transcribe" }
        ],
        timeoutSeconds: 120
      },
      // 视频处理
      video: {
        enabled: true,
        maxBytes: 52428800,  // 50MB
        models: [
          { provider: "google", model: "gemini-3-flash-preview" }
        ]
      }
    }
  },

  // --------------------------------------------------------------------------
  // 七、消息处理配置
  // --------------------------------------------------------------------------
  messages: {
    // 消息前缀 (可选)
    // messagePrefix: "[openclaw]",
    // responsePrefix: ">",
    
    // 收到消息时的反应 emoji
    ackReaction: "👀",
    ackReactionScope: "group-mentions",  // "all" | "group-mentions" | "none"
    
    // 入站消息处理
    inbound: {
      // 消息去抖动 (毫秒) - 合并快速连续的消息
      debounceMs: 2000,
      // 按频道设置
      byChannel: {
        whatsapp: 5000,
        slack: 1500,
        discord: 1500
      }
    },
    
    // 群聊设置
    groupChat: {
      // @mention 模式
      mentionPatterns: ["@openclaw", "openclaw"],
      // 历史消息数量
      historyLimit: 50
    },
    
    // 消息队列
    queue: {
      // 模式: "steer" | "followup" | "collect" | "interrupt"
      mode: "collect",
      debounceMs: 1000,
      cap: 20,
      drop: "summarize",  // "old" | "new" | "summarize"
      byChannel: {
        whatsapp: "collect",
        telegram: "collect",
        discord: "collect",
        webchat: "collect"
      }
    },
    
    // ========== TTS 语音合成 ==========
    tts: {
      // TTS 模式:
      //   "off"     - 关闭语音回复
      //   "always"  - 所有回复都转语音
      //   "inbound" - 收到语音消息时才回语音 (推荐)
      auto: "off",
      
      // TTS 提供商: "edge" | "openai" | "elevenlabs"
      provider: "edge",
      
      // Edge TTS 配置 (免费)
      edge: {
        // 中文语音:
        //   zh-CN-XiaoxiaoNeural (女声)
        //   zh-CN-YunxiNeural (男声)
        //   zh-CN-YunyangNeural (男声)
        // 英文语音:
        //   en-US-JennyNeural (女声)
        //   en-US-GuyNeural (男声)
        voice: "zh-CN-XiaoxiaoNeural"
      }
      
      // OpenAI TTS 配置 (需要 API Key)
      // openai: {
      //   voice: "nova",  // alloy, echo, fable, onyx, nova, shimmer
      //   model: "tts-1"  // tts-1, tts-1-hd
      // }
      
      // ElevenLabs 配置 (需要 API Key)
      // elevenlabs: {
      //   voiceId: "...",
      //   model: "eleven_multilingual_v2"
      // }
    },
    
    // STT 语音转文字
    stt: {
      provider: "openai",
      openai: {
        model: "whisper-1"
      }
    }
  },

  // --------------------------------------------------------------------------
  // 八、会话配置
  // --------------------------------------------------------------------------
  session: {
    // 会话范围:
    //   "main"                    - 所有 DM 共享一个会话
    //   "per-peer"                - 每个联系人独立会话
    //   "per-channel-peer"        - 每个渠道+联系人独立会话
    //   "per-account-channel-peer" - 每个账号+渠道+联系人独立会话
    dmScope: "per-channel-peer",
    
    // 会话重置
    reset: {
      mode: "daily",      // "off" | "daily" | "idle"
      atHour: 4,          // 每日重置时间 (0-23)
      idleMinutes: 60     // 空闲多久后重置
    },
    
    // 重置触发命令
    resetTriggers: ["/new", "/reset"],
    
    // 打字指示器间隔 (秒)
    typingIntervalSeconds: 5
  },

  // --------------------------------------------------------------------------
  // 九、网关配置
  // --------------------------------------------------------------------------
  gateway: {
    // 模式: "local" | "remote"
    mode: "local",
    
    // 监听端口
    port: 18789,
    
    // 绑定地址: "loopback" | "tailnet" | "0.0.0.0"
    bind: "loopback",
    
    // 控制面板 UI
    controlUi: {
      enabled: true,
      basePath: "/openclaw"
    },
    
    // 认证
    auth: {
      mode: "token",      // "token" | "none"
      token: ""           // 留空则自动生成
      // allowTailscale: true
    },
    
    // 远程访问 (可选)
    // remote: {
    //   url: "ws://gateway.tailnet:18789",
    //   token: "remote-token"
    // },
    
    // 配置热重载
    reload: {
      mode: "hybrid",     // "hybrid" | "hot" | "restart" | "off"
      debounceMs: 1000
    }
  },

  // --------------------------------------------------------------------------
  // 十、日志配置
  // --------------------------------------------------------------------------
  logging: {
    level: "info",        // "debug" | "info" | "warn" | "error"
    file: "/tmp/openclaw/openclaw.log",  // 实际文件名带日期: openclaw-YYYY-MM-DD.log
    consoleLevel: "info",
    consoleStyle: "pretty",  // "pretty" | "compact" | "json"
    redactSensitive: "tools"  // "off" | "tools"
  },

  // --------------------------------------------------------------------------
  // 十一、命令配置
  // --------------------------------------------------------------------------
  commands: {
    // 原生命令 (Telegram/Discord 菜单命令)
    native: "auto",  // "auto" | true | false
    
    // 文本命令解析
    text: true,
    
    // Bash 命令 (危险，需要 elevated 权限)
    bash: false,
    bashForegroundMs: 2000,
    
    // 配置命令
    config: false,
    
    // 调试命令
    debug: false,
    
    // 重启命令
    restart: false,
    
    // 使用访问组
    useAccessGroups: true
  },

  // --------------------------------------------------------------------------
  // 十二、技能配置 (可选)
  // --------------------------------------------------------------------------
  skills: {
    // 允许的内置技能
    allowBundled: ["gemini", "peekaboo"],
    
    // 加载配置
    load: {
      // 额外技能目录
      // extraDirs: ["~/Projects/agent-scripts/skills"]
    },
    
    // 安装配置
    install: {
      preferBrew: true,
      nodeManager: "npm"
    }
    
    // 技能条目配置
    // entries: {
    //   "skill-name": {
    //     enabled: true,
    //     apiKey: "...",
    //     env: { KEY: "value" }
    //   }
    // }
  },

  // --------------------------------------------------------------------------
  // 十三、自定义模型提供商 (可选)
  // --------------------------------------------------------------------------
  models: {
    // 模式: "merge" | "replace"
    mode: "merge",
    
    providers: {
      // 自定义代理示例
      // "custom-proxy": {
      //   baseUrl: "http://localhost:4000/v1",
      //   apiKey: "YOUR_KEY",
      //   api: "openai-responses",
      //   authHeader: true,
      //   models: [
      //     {
      //       id: "llama-3.1-8b",
      //       name: "Llama 3.1 8B",
      //       reasoning: false,
      //       input: ["text"],
      //       cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
      //       contextWindow: 128000,
      //       maxTokens: 32000
      //     }
      //   ]
      // }
    }
  },

  // --------------------------------------------------------------------------
  // 十四、消息路由 (多 Agent 场景)
  // --------------------------------------------------------------------------
  bindings: [
    // 路由规则示例
    // {
    //   agentId: "personal",
    //   match: { channel: "whatsapp", accountId: "default" }
    // },
    // {
    //   agentId: "work",
    //   match: { channel: "whatsapp", accountId: "business" }
    // },
    // {
    //   agentId: "family",
    //   match: { channel: "whatsapp", peer: { kind: "group", id: "family-group-id" } }
    // }
  ],

  // --------------------------------------------------------------------------
  // 十五、定时任务 (可选)
  // --------------------------------------------------------------------------
  cron: {
    enabled: false,
    store: "~/.openclaw/cron/cron.json",
    maxConcurrentRuns: 2
    // 单任务 Webhook 投递 (可选)
    // delivery: { mode: "webhook", url: "https://example.com/hook" },
  },

  // --------------------------------------------------------------------------
  // 十六、Webhook (可选)
  // --------------------------------------------------------------------------
  hooks: {
    enabled: false,
    path: "/hooks",
    token: "",
    defaultSessionKey: "hooks",
    allowRequestSessionKey: true,
    // allowedSessionKeyPrefixes: ["ci-"],
    // presets: ["gmail"],
    // transformsDir: "~/.openclaw/hooks",
    // mappings: [
    //   {
    //     match: { source: "github", event: "push" },
    //     action: "message",
    //     agentId: "dev",
    //     deliver: { channel: "telegram", peer: "123456789" }
    //   }
    // ]
  },

  // --------------------------------------------------------------------------
  // 十六(b)、插件配置 (可选, 需要重启)
  // --------------------------------------------------------------------------
  // plugins: {
  //   list: [
  //     { id: "my-plugin", enabled: true }
  //   ]
  // },

  // --------------------------------------------------------------------------
  // 十七、浏览器工具 (全局开关)
  // --------------------------------------------------------------------------
  browser: {
    enabled: true     // 启用浏览器工具
    // Chrome 自定义启动参数 (可选)
    // extraArgs: ["--disable-gpu", "--no-sandbox"],
    // 更多选项见官方文档: https://docs.openclaw.ai/tools/browser
  }
}
