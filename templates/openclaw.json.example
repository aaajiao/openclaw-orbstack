{
  // ============================================================================
  // OpenClaw 完整配置模板 (JSON5 格式 - 支持注释和尾随逗号)
  // 
  // 官方文档: https://docs.openclaw.ai/gateway/configuration
  // 
  // 使用说明:
  //   1. 复制此文件到 ~/.openclaw/openclaw.json (VM 内)
  //   2. 填入你的 API Key 和聊天平台凭据
  //   3. 根据需要调整其他配置
  //   4. 运行 openclaw-restart 重启服务
  //
  // 配置优先级:
  //   1. 运行时指令 (/model, /elevated, /verbose 等)
  //   2. 特定 Agent 配置 (agents.list[].*)
  //   3. 全局默认值 (agents.defaults.*)
  //   4. 内置默认值
  //
  // 多文件配置 (可选):
  //   $include: "./channels.json"                    // 引用单个文件
  //   $include: ["./agents.json", "./channels.json"] // 引用多个文件
  //   支持嵌套引用，最多 10 层
  // ============================================================================

  // --------------------------------------------------------------------------
  // 一、身份设置 (可选但推荐)
  // --------------------------------------------------------------------------
  identity: {
    name: "OpenClaw",           // 机器人名称
    theme: "helpful assistant", // 性格主题
    emoji: "🦞"                 // 代表 emoji (用于 ack 反应)
  },

  // --------------------------------------------------------------------------
  // 二、环境变量 (可选)
  // --------------------------------------------------------------------------
  env: {
    // 直接设置环境变量 (不覆盖已存在的)
    // OPENROUTER_API_KEY: "sk-or-xxxxx",
    
    // vars 块中的变量
    vars: {
      // GROQ_API_KEY: "gsk-xxxxx"
    },
    
    // 从 shell 环境导入 (可选)
    shellEnv: {
      enabled: false,
      timeoutMs: 15000
    }
  },

  // --------------------------------------------------------------------------
  // 三、认证配置 (API Key / OAuth)
  // --------------------------------------------------------------------------
  // 外部 Secrets 管理 (v2026.2.26+):
  //   openclaw secrets audit/configure/apply/reload
  //   支持从 Vault、AWS Secrets Manager 等外部源拉取密钥，通过运行时快照激活
  //
  // Auth profiles 别名规范化 (v2026.2.26+):
  //   旧别名仍可使用，但建议更新:
  //     mode → type    (如 mode: "api_key" → type: "api_key")
  //     apiKey → key   (如 apiKey: "sk-xxx" → key: "sk-xxx")
  auth: {
    // 认证配置文件元数据 (实际密钥存储在 auth-profiles.json)
    profiles: {
      // Anthropic Claude (推荐)
      // OAuth 模式 (Claude Pro/Max 订阅)
      // "anthropic:me@example.com": {
      //   provider: "anthropic",
      //   mode: "oauth",
      //   email: "me@example.com"
      // },
      
      // OpenCode Zen (推荐，多模型统一入口)
      "opencode:default": {
        provider: "opencode",
        mode: "api_key"
      },

      // Anthropic Claude
      // API Key 模式
      "anthropic:api": {
        provider: "anthropic",
        mode: "api_key"
      },
      // Token 模式 (Claude Pro/Max 订阅)
      // "anthropic:manual": {
      //   provider: "anthropic",
      //   mode: "token"
      // },

      // OpenAI
      "openai:default": {
        provider: "openai",
        mode: "api_key"
      },

      // Google Gemini
      "google:default": {
        provider: "google",
        mode: "api_key"
      }
    },

    // 提供商使用顺序 (用于故障转移/负载均衡)
    order: {
      opencode: ["opencode:default"],
      anthropic: ["anthropic:api"],
      openai: ["openai:default"],
      google: ["google:default"]
    },

    // 同 provider 过载时的重试策略 (v2026.3.31+)
    // cooldowns: {
    //   retries: 1,       // 重试次数 (默认 1)
    //   retryDelayMs: 0   // 重试延迟毫秒 (默认 0)
    // }
  },

  // --------------------------------------------------------------------------
  // 三(b)、模型提供商配置 (可选)
  // --------------------------------------------------------------------------
  // 自托管 OpenAI 兼容端点等高级配置
  // models: {
  //   providers: {
  //     "my-local": {
  //       request: {
  //         // 允许私有网络请求 (v2026.4.10+, 仅用于自托管端点)
  //         allowPrivateNetwork: true,
  //       }
  //     }
  //   }
  // },

  // --------------------------------------------------------------------------
  // 四、Agent 运行时配置
  // --------------------------------------------------------------------------
  agents: {
    // 所有 Agent 的默认配置
    defaults: {
      // 工作区目录
      workspace: "~/.openclaw/workspace",
      
      // 用户时区
      userTimezone: "Asia/Shanghai",
      
      // 模型配置
      model: {
        // 主模型 (格式: 提供商/模型名)
        primary: "anthropic/claude-opus-4-6",
        // 备用模型 (主模型失败时使用)
        fallbacks: ["anthropic/claude-sonnet-4-6", "opencode/gemini-3.1-pro"]
      },

      // 图像模型
      imageModel: {
        primary: "opencode/gemini-3.1-pro",
        fallbacks: ["anthropic/claude-sonnet-4-6", "opencode/gemini-3-flash"]
      },

      // PDF 分析模型 (v2026.3.2+)
      // pdfModel 和 pdfMaxBytesMb 是 agents.defaults 的同级字段，不是嵌套关系
      // 不配也能用，自动 fallback: pdfModel → imageModel → 会话默认模型
      // 原生模式 (Anthropic/Gemini) 下 pdfMaxPages 无效（整个 PDF 直接发送）
      pdfModel: {
        primary: "anthropic/claude-sonnet-4-6",
        fallbacks: ["opencode/gemini-3-flash"]
      },
      pdfMaxBytesMb: 30,   // 单个 PDF 最大 MB，默认 10

      // 图片生成模型 (v2026.3.22+)
      // 内置 image_generate 工具，有可用 provider API key 时自动激活
      // 回退顺序: tool call 指定 → primary → fallbacks → 已认证 provider 自动检测
      // imageGenerationModel: {
      //   primary: "openai/gpt-image-1",
      //   fallbacks: ["google/gemini-3.1-flash-image-preview"]
      // },

      // 视频生成模型 (v2026.4.5+, v2026.4.11 增强)
      // 内置 video_generate 工具，支持 xAI (grok-imagine-video)、Alibaba Wan、Runway、fal/Seedance 2.0
      // v2026.4.11: URL-only 交付、typed providerOptions、reference audio 输入、
      //   per-asset role hints、adaptive 宽高比、更高图片输入上限
      // videoGenerationModel: {
      //   primary: "xai/grok-imagine-video"
      // },

      // 音乐生成模型 (v2026.4.5+)
      // 内置 music_generate 工具，支持 Google Lyria、MiniMax、Comfy workflow
      // musicGenerationModel: {
      //   primary: "google/lyria"
      // },

      // 模型目录 / 别名
      // Anthropic 1M 上下文 Beta: params: { context1m: true }
      //   仅 API Key 模式支持，token/OAuth 不支持；>200K 按 premium 计费
      models: {
        // v2026.4.15: Anthropic 默认已升级到 Claude Opus 4.7
        //   (opus 别名、Claude CLI 默认、bundled image understanding 都指向 4.7)
        // "anthropic/claude-opus-4-7": { alias: "Opus 4.7" },
        "anthropic/claude-opus-4-6": { alias: "Opus 4.6" },
        // params: { context1m: true } — 仅 API Key 模式，需要 Usage Tier 4+
        // "anthropic/claude-opus-4-6": { alias: "Opus 4.6", params: { context1m: true } },
        "anthropic/claude-sonnet-4-6": { alias: "Sonnet 4.6" },
        "anthropic/claude-haiku-4-5": { alias: "Haiku 4.5" },
        "opencode/gemini-3.1-pro": { alias: "Gemini 3.1 Pro" },
        "opencode/gemini-3-flash": { alias: "Gemini 3 Flash" },
        "google/gemini-3.1-flash-lite-preview": { alias: "Gemini 3.1 Flash Lite" },
        "opencode/kimi-k2.5": { alias: "Kimi K2.5" },
        "opencode/gpt-5.2": { alias: "GPT 5.2" },
        "opencode/gpt-5.3-codex": { alias: "GPT 5.3 Codex" },
        "opencode/gpt-5.4": { alias: "GPT 5.4" },
        "openai/gpt-5.4-mini": { alias: "GPT 5.4 Mini" },
        "openai/gpt-5.4-nano": { alias: "GPT 5.4 Nano" },
        // v2026.4.14: gpt-5.4-pro forward-compat (Codex pricing/limits pre-catalog)
        // "openai/gpt-5.4-pro": { alias: "GPT 5.4 Pro" }
        // v2026.4.10: codex/gpt-* 路径走 Codex 托管认证 (原生线程、模型发现、压缩)
        // v2026.4.12: Codex bundled provider + plugin-owned app-server harness
        //   codex/gpt-* 使用 Codex-managed auth，openai/gpt-* 仍走常规 OpenAI 路径
        // "codex/gpt-5.4": { alias: "GPT 5.4 (Codex)" }
      },

      // ========== Fast Mode (v2026.3.12+) ==========
      // 会话级 fast toggle，跨 /fast、TUI、Control UI、ACP 生效
      // 支持 OpenAI (Codex request shaping) 和 Anthropic (service_tier)
      // fastMode: {
      //   default: false,           // 默认是否启用 fast mode
      //   // 按模型配置 fast mode 默认值
      //   // byModel: {
      //   //   "openai/gpt-5.4": true,
      //   //   "anthropic/claude-sonnet-4-6": false,
      //   // }
      // },
      
      // 默认思考级别: "off" | "low" | "high"
      thinkingDefault: "low",
      
      // 默认详细模式: "off" | "on"
      verboseDefault: "off",
      
      // 全局默认 provider 参数 (v2026.4.1+)
      // 应用于所有模型，可被 agents.list[].params 或 models 目录中的 per-model params 覆盖
      // params: {
      //   cacheRetention: "long"
      // },

      // 默认提权模式: "off" | "on"
      elevatedDefault: "on",
      
      // 超时时间 (秒)
      timeoutSeconds: 600,

      // LLM 空闲超时 (秒, v2026.4.9+)
      // 默认继承 timeoutSeconds，单独设置可解耦 LLM 空闲看门狗与整体超时
      // cron 任务自动跳过空闲看门狗
      // llm: {
      //   idleTimeoutSeconds: 600,
      // },

      // 媒体文件大小限制 (MB)
      mediaMaxMb: 5,
      
      // 打字指示器间隔 (秒)
      typingIntervalSeconds: 5,
      
      // 上下文窗口大小 (tokens)
      contextTokens: 250000,

      // 最大并发任务数
      maxConcurrent: 4,
      
      // 人类延迟模拟
      humanDelay: {
        mode: "natural"  // "off" | "natural" | "fixed"
      },
      
      // 系统提示词覆盖 (v2026.4.7+)
      // 替换 OpenClaw 自动组装的整个系统提示词为固定字符串
      // 用于受控提示词实验；per-agent 覆盖优先级更高
      // systemPromptOverride: "你是一个只回答数学问题的助手",

      // ========== 心跳配置 (v2026.2.25+) ==========
      // heartbeat: {
      //   every: "30m",              // 心跳间隔: "30m" | "1h" | "2h"
      //   target: "none",            // 投递目标: "none" | "last" | channel/peer
      //   // DM 投递策略 (v2026.2.25+)
      //   // v2026.2.24 曾默认改为 block，v2026.2.25 恢复为 allow
      //   directPolicy: "allow",     // "allow" - 允许投递到私聊 | "block" - 只投递到群组/频道
      //   // 心跳 Agent 超时 (v2026.4.10+)
      //   // timeoutSeconds: 300,    // 默认继承 agents.defaults.timeoutSeconds
      // },

      // ========== 子代理配置 ==========
      subagents: {
        maxConcurrent: 4,
        archiveAfterMinutes: 15,
        model: {
          primary: "anthropic/claude-sonnet-4-6",
          fallbacks: ["opencode/gemini-3-flash", "anthropic/claude-haiku-4-5"]
        }
      },

      // 块流式传输配置
      blockStreamingDefault: "off",  // "off" | "on"
      blockStreamingBreak: "text_end",
      blockStreamingChunk: {
        minChars: 800,
        maxChars: 1200,
        breakPreference: "paragraph"  // "paragraph" | "newline" | "sentence"
      },
      
      // ========== 记忆搜索配置 ==========
      // 重要：Memory Search 需要 embedding API 才能工作！
      // 必须在 ~/.openclaw/agents/<agentId>/agent/auth-profiles.json 中配置
      // OpenAI 或 Google 的 API key，否则索引无法创建。
      // 
      // 配置步骤：
      // 1. 编辑 auth-profiles.json，在 profiles 中添加 "openai:default" 或 "google:default"
      // 2. 运行 openclaw memory status --deep 验证配置
      // 3. 运行 openclaw memory index 构建索引
      //
      // 详见 docs/configuration-guide.md 和 docs/troubleshooting.md
      memorySearch: {
        enabled: true,
        // provider: "auto",  // "auto" | "openai" | "gemini" | "local" | "ollama"
        // auto 模式会按顺序尝试: local → openai → gemini
        // 如果没有可用的 embedding provider，memory search 会被静默禁用
        sources: ["memory", "sessions"],
        experimental: {
          sessionMemory: true   // 索引会话记录
        },
        fallback: "openai",     // 主 provider 失败时的后备
        store: {
          path: "~/.openclaw/memory/{agentId}.sqlite",
          vector: {
            enabled: true
          }
        },
        sync: {
          watch: true,          // 监控文件变化
          sessions: {
            deltaBytes: 50000,  // 每 50KB 变化同步一次
            deltaMessages: 30,  // 或每 30 条消息同步一次
            // 压缩后强制同步会话记忆 (v2026.3.12+)
            // postCompactionForce: false,  // 默认不强制，避免同步开销
          }
        },
        query: {
          hybrid: {             // BM25 + 向量混合搜索
            enabled: true,
            vectorWeight: 0.7,
            textWeight: 0.3,
            candidateMultiplier: 4
          }
        },
        cache: {
          enabled: true,
          maxEntries: 50000
        },
        remote: {
          batch: {
            enabled: true,      // Batch API 便宜 50% 但较慢
            concurrency: 2
          }
        },
        // 跨 Agent 会话搜索 (v2026.3.31+)
        // 允许当前 Agent 搜索其他 Agent 的会话记录（QMD 后端）
        // qmd: {
        //   extraCollections: ["other-agent-id"]
        // },
        // 额外索引目录
        // extraPaths: ["docs", "assets/diagrams"],
        // 多模态索引 (v2026.3.11+, 仅 Gemini embedding)
        // 需要 provider: "gemini", model: "gemini-embedding-2-preview"
        // 开启后 fallback 必须为 "none"
        // multimodal: {
        //   enabled: true,
        //   modalities: ["image", "audio"],  // 或 ["all"]
        //   maxFileBytes: 10000000           // 10MB
        // },
      },

      // ========== 上下文修剪配置 ==========
      contextPruning: {
        mode: "cache-ttl",      // "off" | "cache-ttl"
        ttl: "3h",              // 超过 TTL 的工具结果会被修剪
        keepLastAssistants: 3,  // 保留最近 N 条助手消息
        softTrimRatio: 0.25,
        hardClearRatio: 0.4,
        minPrunableToolChars: 4000,
        tools: {
          deny: ["browser", "canvas"]   // 这些工具的结果不修剪
        },
        softTrim: {
          maxChars: 4000,
          headChars: 1500,
          tailChars: 1500
        },
        hardClear: {
          enabled: true,
          placeholder: "[content pruned to save context space]"
        }
      },

      // ========== 压缩 / 记忆刷盘配置 ==========
      compaction: {
        mode: "safeguard",      // "off" | "safeguard"
        reserveTokensFloor: 30000,
        // 压缩后重新注入的 AGENTS.md H2/H3 段落 (v2026.3.7+)
        // 默认: ["Session Startup", "Red Lines"]，设为 [] 禁用重注入
        // postCompactionSections: ["Session Startup", "Red Lines"],
        // 压缩质量保护：保留最近 N 轮对话不被压缩 (v2026.3.7+)
        // recentTurnsPreserve: 3,
        // 压缩后重新索引记忆 (v2026.3.12–v2026.4.8, v2026.4.9 移除)
        // postIndexSync 已废弃 — 记忆索引现在自动管理
        // 压缩摘要自定义指令 (v2026.3.13+)
        // 用于保持压缩后的语言/人格一致性（防止非英语会话被压缩成英语）
        // 不设置时使用内置默认指令（自动检测会话语言并保持）
        // 最大 800 字符
        // customInstructions: "用中文撰写压缩摘要，保持事实准确",
        // 压缩开始通知 (v2026.4.2–v2026.4.8, v2026.4.9 移除)
        // notifyUser 已废弃 — 通知行为现在由 Gateway 自动管理
        // 可插拔压缩提供商 (v2026.4.7+)
        // 设置后替换内置 LLM 摘要，使用注册的压缩提供商插件
        // provider: "my-compaction-plugin",
        // v2026.3.28: flush prompts 由 memory-core 插件管理，不再需要手动配置
        // prompt/systemPrompt 已移除，插件使用内置默认策略
        memoryFlush: {
          enabled: true,
          softThresholdTokens: 15000
        }
      },
      
      // ========== 沙箱配置 ==========
      // 重要概念:
      // - AI 大脑运行在云端 (Anthropic/OpenAI/Google)，不在沙箱里
      // - 沙箱是 AI 的"手"——只执行工具，不运行 AI
      // - 运行时有两个沙箱容器:
      //   1. sandbox.docker  → 代码执行沙箱 (exec, read, write, edit)
      //   2. sandbox.browser → 浏览器沙箱 (Playwright, Chromium)
      // - 构建时有三个 Docker 镜像:
      //   1. openclaw-sandbox:bookworm-slim        → 基础镜像 (构建依赖)
      //   2. openclaw-sandbox-common:bookworm-slim  → 基于 1 + 开发工具 (代码执行用)
      //   3. openclaw-sandbox-browser:bookworm-slim → 独立构建 (浏览器用)
      sandbox: {
        // 沙箱模式:
        //   "off"      - 不使用沙箱 (危险：AI 可访问 /mnt/mac)
        //   "non-main" - 非主会话使用沙箱 (main session 无法用 sandbox browser)
        //   "all"      - 所有会话都使用沙箱 (推荐：所有功能可用)
        mode: "all",
        
        // 隔离范围:
        //   "session" - 每个会话独立容器
        //   "agent"   - 每个 Agent 独立容器
        //   "shared"  - 共享容器
        scope: "agent",
        
        // 工作区访问权限:
        //   "none" - 无访问权限
        //   "ro"   - 只读
        //   "rw"   - 读写
        workspaceAccess: "rw",
        
        // 沙箱工作区根目录
        workspaceRoot: "~/.openclaw/sandboxes",
        
        // ===== 代码执行沙箱配置 (sandbox.docker) =====
        // 注意: 配置名是 "docker" 但这是"代码执行沙箱"的配置，不是通用 Docker 配置
        docker: {
          // 沙箱镜像
          image: "openclaw-sandbox-common:bookworm-slim",
          // 容器名称前缀
          containerPrefix: "openclaw-sbx-",
          // 工作目录
          workdir: "/workspace",
          // 根文件系统只读
          readOnlyRoot: true,
          // tmpfs 挂载点 (/tmp 需要 exec 权限让 Playwright 能执行)
          tmpfs: ["/tmp:exec,mode=1777", "/var/tmp", "/run"],
          // 网络模式:
          //   "none"   - 无网络 (代码执行最安全，但浏览器无法上网)
          //   "bridge" - 桥接网络 (推荐：浏览器可上网，Docker 仍隔离 Mac 文件系统)
          //   "host"   - 主机网络
          network: "bridge",
          // 运行用户 (macOS 默认用户是 501:501，需要匹配 workspace 权限)
          user: "501:501",
          // 放弃的 Linux capabilities
          capDrop: ["ALL"],
          // 环境变量 (传递给沙箱容器)
          // 重要: API Key 必须在这里配置才能在沙箱内使用！
          // 顶层 env 块的变量不会自动传递到沙箱容器
          // 注意: TELEGRAM_BOT_TOKEN、DISCORD_BOT_TOKEN 等被 Gateway 保留，
          //       需改名为 TG_BOT_TOKEN、DISCORD_TOKEN 才能传到沙箱
          env: {
            LANG: "C.UTF-8",
            // OPENCLAW_GATEWAY_TOKEN 由 Gateway 自动注入，通常不需要手动配置
            // 添加你需要在沙箱内使用的 API Key:
            // 可以用 ${VAR} 引用 .env 文件中的变量，也可以直接填值
            // OPENAI_API_KEY: "${OPENAI_API_KEY}",
            // ANTHROPIC_API_KEY: "${ANTHROPIC_API_KEY}",
            // GOOGLE_API_KEY: "${GOOGLE_API_KEY}",
            // TG_BOT_TOKEN: "${TG_BOT_TOKEN}"  // 用 TG_BOT_TOKEN 而非 TELEGRAM_BOT_TOKEN
          },
          // 资源限制
          pidsLimit: 256,        // 最大进程数
          memory: "1g",          // 内存限制
          memorySwap: "2g",      // 内存+交换限制
          cpus: 1,               // CPU 限制
          ulimits: {
            nofile: { soft: 1024, hard: 2048 },
            nproc: 256
          }
          // 可选配置:
          // setupCommand: "apt-get update && apt-get install -y git",
          // dns: ["1.1.1.1", "8.8.8.8"],
          // extraHosts: ["myhost:192.168.1.1"],
          // 容器网络命名空间共享 (v2026.2.24+ 默认阻止)
          // Docker network: "container:<id>" 模式已被默认禁用
          // 如需恢复旧行为，显式设置为 true
          // dangerouslyAllowContainerNamespaceJoin: false
        },
        
        // ===== 浏览器沙箱配置 (sandbox.browser) =====
        browser: {
          enabled: true,
          image: "openclaw-sandbox-browser:bookworm-slim",
          headless: true,
          autoStart: true,              // 自动启动浏览器沙箱
          autoStartTimeoutMs: 30000,    // 启动超时 30 秒
          allowHostControl: true,       // 允许 target="host" 访问宿主浏览器
          // SSRF 保护策略 (v2026.2.20+)
          // "strict" - 阻止访问私有网络地址 (默认)
          // "warn"   - 记录警告但允许
          // "off"    - 关闭检查
          // ssrfPolicy: "strict",
          // dangerouslyAllowPrivateNetwork: false,  // 仅调试用
          // 浏览器沙箱环境变量 (可选，通常不需要配置)
          // OPENCLAW_GATEWAY_TOKEN 由 Gateway 自动注入
          // env: {
          //   LANG: "C.UTF-8",
          //   OPENAI_API_KEY: "sk-xxx"  // 如果浏览器沙箱需要 API Key
          // }
        },
        
        // 自动清理
        prune: {
          idleHours: 0,    // 空闲多久后清理 (0 = 禁用，不自动清理)
          maxAgeDays: 0    // 最大存活天数 (0 = 禁用，不自动清理)
        }
      }
    },
    
    // 特定 Agent 配置列表 (覆盖默认值)
    list: [
      // 示例: 个人 Agent (完全访问)
      // {
      //   id: "personal",
      //   default: true,
      //   name: "个人助手",
      //   workspace: "~/.openclaw/workspace-personal",
      //   model: { primary: "anthropic/claude-opus-4-6" },
      //   sandbox: { mode: "off" }
      // },
      
      // 示例: 公共 Agent (受限访问)
      // {
      //   id: "public",
      //   name: "公共助手",
      //   workspace: "~/.openclaw/workspace-public",
      //   model: { primary: "anthropic/claude-haiku-4-5" },
      //   // 每个 Agent 的运行时参数 (v2026.3.13+ config validate 支持)
      //   // params: {
      //   //   temperature: 0.7,
      //   //   maxTokens: 4096,
      //   //   cacheRetention: "1h"
      //   // },
      //   sandbox: {
      //     mode: "all",
      //     scope: "session",
      //     workspaceAccess: "none",
      //     docker: { network: "none" }
      //   },
      //   tools: {
      //     deny: ["exec", "write", "edit", "apply_patch", "browser"]
      //   }
      // }
    ]
  },

  // --------------------------------------------------------------------------
  // 五、聊天频道配置
  // --------------------------------------------------------------------------
  channels: {
    // ========== WhatsApp ==========
    whatsapp: {
      // DM 策略:
      //   "pairing"   - 需要配对码 (推荐)
      //   "allowlist" - 仅允许列表中的用户
      //   "open"      - 允许所有人 (需要 allowFrom 包含 "*")
      //   "disabled"  - 禁用 DM
      dmPolicy: "pairing",
      
      // DM 允许列表 (E.164 格式: +国家码手机号)
      allowFrom: [
        // "+8613800138000"
      ],
      
      // 群组策略: "open" | "allowlist" | "disabled"
      groupPolicy: "allowlist",
      
      // 群组允许列表
      groupAllowFrom: [
        // "+8613800138000"
      ],
      
      // 群组设置
      groups: {
        // 所有群组的默认设置
        "*": {
          requireMention: true  // 需要 @mention 才回复
        }
        // 特定群组设置
        // "120363403215116621@g.us": {
        //   requireMention: false,
        //   allowFrom: ["@admin"]
        // }
      },
      
      // Agent 反应级别 (v2026.4.1+)
      // reactionLevel: "default",  // agent 对用户消息的 emoji 反应策略

      // 是否发送已读回执 (蓝勾)
      sendReadReceipts: true,
      
      // 媒体大小限制 (MB)
      mediaMaxMb: 50,
      
      // 消息分块限制 (字符)
      textChunkLimit: 4000,
      
      // 分块模式: "length" | "newline"
      chunkMode: "length"
      
      // 多账户配置 (可选)
      // accounts: {
      //   default: {},
      //   business: {}
      // }
    },
    
    // ========== Telegram ==========
    telegram: {
      enabled: false,  // 改为 true 启用
      
      // Bot Token (从 @BotFather 获取)
      // 或设置环境变量 TELEGRAM_BOT_TOKEN
      botToken: "",
      
      // DM 策略
      dmPolicy: "pairing",
      
      // DM 允许列表 (Telegram 用户 ID 或用户名)
      allowFrom: [
        // "123456789",
        // "@username"
      ],
      
      // 群组策略
      groupPolicy: "allowlist",
      groupAllowFrom: [],
      
      // 群组设置
      // ⚠️ v2026.4.1: groupMentionsOnly 已移除，迁移到 groups["*"].requireMention
      groups: {
        "*": { requireMention: true }
        // "-1001234567890": {
        //   requireMention: false,
        //   allowFrom: ["@admin"],
        //   systemPrompt: "保持回答简洁",
        //   topics: {
        //     "99": {
        //       requireMention: false,
        //       skills: ["search"],
        //       agentId: "topic-agent"  // 按 topic 路由到不同 Agent (v2026.3.7+)
        //     }
        //   }
        // }
      },
      
      // 历史消息上下文数量
      historyLimit: 50,
      
      // 回复模式: "off" | "first" | "all"
      replyToMode: "first",
      
      // 链接预览
      linkPreview: true,
      
      // 流式传输 (v2026.4.9+: 从标量迁移到对象格式)
      // mode: "off" | "partial" | "block" | "progress" (默认 "partial")
      // 旧标量格式 streaming: "partial" 仍可用，openclaw doctor --fix 自动迁移
      streaming: {
        mode: "partial",
        // chunkMode: "word",              // 分块模式 (可选)
        // preview: { chunk: true },       // 预览分块 (可选)
        // block: {                        // block 模式配置 (可选)
        //   enabled: false,
        //   coalesce: true
        // }
      },

      // 内联按钮样式: "primary" | "success" | "danger" (可选)
      // buttonStyle: "primary",

      // 用户消息反应作为系统事件 (默认开启)
      // surfaceReactions: true,
      
      // 媒体大小限制 (MB)
      mediaMaxMb: 5,
      
      // 自定义命令
      // 注意: 不要重复内置命令 (new, status, stop, model, usage, think, subagents 等)
      // 内置命令由 Gateway 自动注册，重复声明会导致启动报错
      customCommands: [
        // { command: "backup", description: "Git 备份" },
        // { command: "image", description: "生成图片" }
      ]

      // disableAudioPreflight: false,  // Skip TTS capability check before voice reply

      // 代理设置 (可选)
      // proxy: "socks5://localhost:9050"
      
      // Webhook 模式 (可选)
      // webhookUrl: "https://example.com/telegram-webhook",
      // webhookSecret: "secret"

      // 自定义 Bot API 端点 (v2026.3.22+, 自建 Bot API 服务器)
      // apiBaseUrl: "https://my-bot-api.example.com",

      // DM 论坛话题自动重命名 (v2026.3.22+, LLM 生成标题)
      // autoTopicLabel: true,

      // 错误回复静音发送 (v2026.3.22+, 默认 false)
      // silentErrorReplies: false,

      // 投递错误抑制策略 (v2026.4.1+)
      // 按 account/chat/topic 抑制重复投递错误
      // errorPolicy: "suppress",    // "suppress" | "propagate"
      // errorCooldownMs: 60000,     // 抑制冷却时间 (毫秒)
    },
    
    // ========== Discord ==========
    discord: {
      enabled: false,  // 改为 true 启用
      
      // Bot Token (从 Discord Developer Portal 获取)
      // 或设置环境变量 DISCORD_BOT_TOKEN
      token: "",
      
      // 媒体大小限制 (MB)
      mediaMaxMb: 8,
      
      // 是否允许其他机器人的消息
      allowBots: false,
      
      // DM 设置
      dm: {
        enabled: true,
        policy: "pairing",  // "pairing" | "allowlist" | "open" | "disabled"
        allowFrom: [
          // "123456789012345678",  // 用户 ID
          // "username"             // 用户名
        ],
        groupEnabled: false,  // 群组 DM
        groupChannels: []
      },
      
      // 自动建线程的归档时间 (v2026.3.11+)
      // autoArchiveDuration: "1 day",  // "1 hour" | "1 day" | "3 days" | "1 week"

      // 自动线程命名 (v2026.3.24+)
      // 设为 "generated" 时用 LLM 自动生成简短线程标题，默认使用消息内容命名
      // autoThreadName: "generated",

      // 服务器设置
      guilds: {
        // "123456789012345678": {
        //   slug: "my-server",
        //   requireMention: false,
        //   reactionNotifications: "own",
        //   users: ["987654321098765432"],
        //   channels: {
        //     "general": { enabled: true },
        //     "help": {
        //       enabled: true,
        //       requireMention: true,
        //       users: ["987654321098765432"],
        //       skills: ["docs"]
        //     }
        //   }
        // }
      },
      
      // 历史消息上下文数量
      historyLimit: 20,
      
      // 回复模式
      replyToMode: "off",
      
      // 消息分块限制
      textChunkLimit: 2000,
      maxLinesPerMessage: 17,
      
      // 动作权限
      actions: {
        reactions: true,
        stickers: true,
        polls: true,
        messages: true,
        threads: true,
        pins: true,
        search: true,
        memberInfo: true,
        roleInfo: true,
        channelInfo: true,
        voiceStatus: true,
        events: true,
        permissions: true,
        roles: false,      // 危险操作默认关闭
        moderation: false  // 危险操作默认关闭
      },

      // 可复用交互组件
      // components: { reusable: true },

      // 原生 /exec 命令 (带自动补全)
      // exec: { enabled: true }
    },
    
    // ========== Slack ==========
    slack: {
      enabled: false,  // 改为 true 启用
      
      // Bot Token (xoxb-...)
      botToken: "",
      
      // App Token (xapp-...)
      appToken: "",
      
      // 频道设置
      channels: {
        // "#general": { enabled: true, requireMention: true }
      },
      
      // DM 设置
      dm: {
        enabled: true,
        allowFrom: [
          // "U123456789"  // Slack 用户 ID
        ]
      },
      
      // 斜杠命令
      slashCommand: {
        enabled: true,
        name: "openclaw",
        sessionPrefix: "slack:slash",
        ephemeral: true
      },

      // 消息流式传输模式: "off" | "native" | "draft"
      // native 使用 Slack 原生单消息流 (chat.startStream/appendStream/stopStream)
      streamMode: "off",

      // Socket Mode DM 中显示处理状态反应 (v2026.3.7+)
      // typingReaction: false,

      // v2026.3.12: 频道路由默认使用稳定 ID，可变名称匹配需显式启用
      // dangerouslyAllowNameMatching: false,
    },
    
    // ========== Google Chat ==========
    googlechat: {
      enabled: false
      // 通过 openclaw channels add --channel googlechat 配置
    },

    // ========== Signal ==========
    signal: {
      enabled: false
      // 手机号 (E.164 格式)
      // number: "+8613800138000"
      // 群组设置 (v2026.3.13+ config validate 支持)
      // groups: {
      //   "*": { requireMention: true },
      //   // "<group-id>": {
      //   //   requireMention: false,
      //   //   tools: ["web_search"],
      //   //   toolsBySender: { "+8613800138000": ["exec"] }
      //   // }
      // }
    },

    // ========== BlueBubbles (推荐替代 iMessage legacy) ==========
    bluebubbles: {
      enabled: false
      // 支持编辑、反应、群管理等完整功能
      // 通过 openclaw channels add --channel bluebubbles 配置
    },

    // ========== iMessage legacy (不推荐，建议用 BlueBubbles) ==========
    imessage: {
      enabled: false
    }

    // ========== 插件频道 (需要 openclaw plugins install) ==========
    // 25+ channels via plugins: Feishu, Mattermost, Teams, LINE, Matrix, QQ Bot (v2026.3.31), Zalo, ...
    // QQ Bot: 内置频道插件，支持多账号、斜杠命令、提醒、媒体收发
    // 通过 openclaw plugins list 查看可用插件

    // 频道默认配置 (v2026.4.5+)
    // defaults: {
    //   // 上下文可见性: 控制引用/线程/历史上下文的可见性
    //   //   "all"             - 包含所有上下文 (默认)
    //   //   "allowlist"       - 仅包含 allowlist 发送者的上下文
    //   //   "allowlist_quote" - 同 allowlist 但保留显式引用/回复上下文
    //   // contextVisibility: "all",
    // },

    // 按频道指定模型 (v2026.2.21+)
    // modelByChannel: {
    //   telegram: "anthropic/claude-sonnet-4-5",
    //   discord: "anthropic/claude-haiku-4-5"
    // }
  },

  // --------------------------------------------------------------------------
  // 六、工具权限配置
  // --------------------------------------------------------------------------
  tools: {
    // Web 搜索工具
    web: {
      search: {
        // v2026.3.28: provider 细节配置迁移到 plugins.entries.<provider>.config
        provider: "perplexity",   // "brave" | "exa" | "google" | "perplexity" | "searxng" | "tavily"
        // Brave Search (需要 BRAVE_API_KEY)
        // brave: {
        //   mode: "llm-context"  // "llm-context" = Brave LLM Context endpoint，返回提取的 grounding 片段 (v2026.3.8+)
        // }
      }
    },

    // 沙箱工具权限 (仅在沙箱模式下生效)
    sandbox: {
      tools: {
        // 允许的工具组:
        //   group:runtime  = exec, bash, process
        //   group:fs       = read, write, edit, apply_patch
        //   group:sessions = sessions_list, sessions_history, sessions_send, sessions_spawn, sessions_yield, session_status
        //   group:ui       = browser, canvas
        allow: [
          "group:runtime",
          "group:fs",
          "group:sessions",
          "group:ui",
          "cron",
          "memory_search",
          "memory_get",
          "web_search",
          "web_fetch"
          // "video_generate",  // 视频生成 (v2026.4.5+)
          // "music_generate",  // 音乐生成 (v2026.4.5+)
        ],
        // 禁止的工具 (会覆盖 allow)
        deny: [
          "nodes",
          "gateway",
          "telegram",
          "whatsapp",
          "discord",
          "googlechat",
          "slack",
          "signal",
          "imessage"
        ]
      }
    },
    
    // Web Fetch 配置
    // ⚠️ v2026.4.2 Breaking: Firecrawl 已迁移到 plugins.entries.firecrawl.config.webFetch
    // ⚠️ v2026.4.2 Breaking: xAI x_search 已迁移到 plugins.entries.xai.config.xSearch
    // 旧路径 (tools.web.fetch.firecrawl / tools.web.x_search) 不再生效
    // 运行 `openclaw doctor --fix` 自动迁移
    // web: {
    //   fetch: {
    //     readability: true,      // Readability 主内容提取 (默认开启)
    //     // SSRF 策略 (v2026.4.10+)
    //     // ssrfPolicy: {
    //     //   allowRfc2544BenchmarkRange: false,  // 允许 198.18.0.0/15 (fake-IP 代理环境)
    //     // },
    //   },
    // },

    // Web 工具 URL 白名单 (可选)
    // webSearch: { allowedUrls: ["*.example.com"] },
    // webFetch: { allowedUrls: ["*.example.com"] },

    // 执行工具配置
    exec: {
      backgroundMs: 10000,      // 后台执行阈值 (毫秒)
      timeoutSec: 1800,         // 超时时间 (秒)
      cleanupMs: 1800000        // 清理时间 (毫秒)
    },
    
    // 提权配置 (允许危险操作)
    elevated: {
      enabled: false,
      // 各频道的提权用户列表
      allowFrom: {
        whatsapp: [
          // "+8613800138000"
        ],
        telegram: [
          // "123456789"
        ],
        discord: [
          // "username"
        ],
        slack: [
          // "U123"
        ]
      }
    },
    
    // 实验性功能 (v2026.4.8+)
    experimental: {
      // update_plan 工具 — 多步骤任务结构化进度报告
      // OpenAI 系模型自动启用，其他模型默认关闭
      // planTool: false,
    },

    // 媒体处理配置
    media: {
      // 音频处理
      audio: {
        enabled: true,
        maxBytes: 20971520,  // 20MB
        models: [
          { provider: "openai", model: "gpt-4o-mini-transcribe" }
        ],
        timeoutSeconds: 120
      },
      // 视频处理
      video: {
        enabled: true,
        maxBytes: 52428800,  // 50MB
        models: [
          { provider: "google", model: "gemini-3-flash-preview" }
        ]
      },
      // 异步完成交付 (v2026.4.11+)
      // 控制异步音乐/视频生成完成后是否直接投递到频道
      // asyncCompletion: {
      //   directSend: false,  // true = 直接投递到频道，false = 唤醒请求者会话 (默认)
      // },
    }
  },

  // --------------------------------------------------------------------------
  // 七、消息处理配置
  // --------------------------------------------------------------------------
  messages: {
    // 消息前缀 (可选)
    // messagePrefix: "[openclaw]",
    // responsePrefix: ">",
    
    // 收到消息时的反应 emoji
    ackReaction: "👀",
    ackReactionScope: "all",  // "all" | "group-mentions" | "none"
    removeAckAfterReply: true,
    
    // 入站消息处理
    inbound: {
      // 消息去抖动 (毫秒) - 合并快速连续的消息
      debounceMs: 2000,
      // 按频道设置
      byChannel: {
        whatsapp: 5000,
        slack: 1500,
        discord: 1500
      }
    },
    
    // 群聊设置
    groupChat: {
      // @mention 模式
      mentionPatterns: ["@openclaw", "openclaw"],
      // 历史消息数量
      historyLimit: 50
    },
    
    // 消息队列
    queue: {
      // 模式: "steer" | "followup" | "collect" | "interrupt"
      mode: "collect",
      debounceMs: 1000,
      cap: 20,
      drop: "summarize",  // "old" | "new" | "summarize"
      byChannel: {
        whatsapp: "collect",
        telegram: "collect",
        discord: "collect",
        webchat: "collect"
      }
    },
    
    // ========== TTS 语音合成 ==========
    // v2026.3.28: provider 配置从 tts.<provider> 迁移到 tts.providers.<provider>
    tts: {
      // TTS 模式:
      //   "off"     - 关闭语音回复
      //   "always"  - 所有回复都转语音
      //   "inbound" - 收到语音消息时才回语音 (推荐)
      auto: "off",

      // TTS 提供商: "edge" | "openai" | "elevenlabs" | "google" (v2026.4.15+)
      provider: "edge",

      // 各提供商配置 (v2026.3.28+ 新结构)
      providers: {
        // Edge TTS (免费)
        edge: {
          // 中文语音:
          //   zh-CN-XiaoxiaoNeural (女声)
          //   zh-CN-YunxiNeural (男声)
          //   zh-CN-YunyangNeural (男声)
          // 英文语音:
          //   en-US-JennyNeural (女声)
          //   en-US-GuyNeural (男声)
          voice: "zh-CN-XiaoxiaoNeural"
        }

        // OpenAI TTS (需要 API Key)
        // openai: {
        //   voice: "nova",  // alloy, echo, fable, onyx, nova, shimmer
        //   model: "gpt-4o-mini-tts",  // gpt-4o-mini-tts, tts-1, tts-1-hd
        //   baseUrl: "https://api.openai.com/v1"  // 自定义 TTS endpoint
        // }

        // ElevenLabs (需要 API Key)
        // elevenlabs: {
        //   voiceId: "...",
        //   model: "eleven_multilingual_v2"
        // }

        // Google Gemini TTS (v2026.4.15+, bundled google plugin)
        // API key 自动从以下来源读取 (按优先级):
        //   messages.tts.providers.google.apiKey →
        //   models.providers.google.apiKey →
        //   GEMINI_API_KEY 环境变量 → GOOGLE_API_KEY 环境变量
        // 30 个跨语种声线 (支持普通话), 返回 24kHz PCM / WAV (不支持 voice note)
        // Voice: Kore(稳重) / Sulafat(暖) / Zephyr(明亮) / Leda(年轻) / Charon(权威) 等
        // 试听: https://aistudio.google.com/apps/bundled/voice-library?showPreview=true
        // google: {
        //   model: "gemini-3.1-flash-tts-preview",
        //   voiceName: "Kore"
        // }
      }
    },
    
    // STT 语音转文字
    stt: {
      provider: "openai",
      openai: {
        model: "whisper-1"
      }
    }
  },

  // --------------------------------------------------------------------------
  // 八、会话配置
  // --------------------------------------------------------------------------
  session: {
    // 会话范围:
    //   "main"                    - 所有 DM 共享一个会话
    //   "per-peer"                - 每个联系人独立会话
    //   "per-channel-peer"        - 每个渠道+联系人独立会话
    //   "per-account-channel-peer" - 每个账号+渠道+联系人独立会话
    dmScope: "per-channel-peer",
    
    // 会话重置
    reset: {
      mode: "daily",      // "off" | "daily" | "idle"
      atHour: 4,          // 每日重置时间 (0-23)
      idleMinutes: 60     // 空闲多久后重置
    },
    
    // 重置触发命令
    resetTriggers: ["/new", "/reset"],

    // Slack 线程父会话 token 上限 (v2026.2.25+)
    // 防止父会话过大导致子线程继承时卡死
    // parentForkMaxTokens: 100000,

    // 打字指示器间隔 (秒)
    typingIntervalSeconds: 5,
    // 会话磁盘管理 (v2026.2.23+)
    // maintenance: {
    //   maxDiskBytes: 524288000,   // 磁盘配额 (~500MB)
    //   highWaterBytes: 419430400, // 触发清理阈值 (~400MB)
    //   pruneOlderThanDays: 30    // 清理超过 N 天的会话
    // },
  },

  // --------------------------------------------------------------------------
  // 九、网关配置
  // --------------------------------------------------------------------------
  gateway: {
    // 模式: "local" | "remote"
    mode: "local",
    
    // 监听端口
    port: 18789,
    
    // 绑定地址: "loopback" | "tailnet" | "0.0.0.0"
    bind: "loopback",
    
    // 控制面板 UI
    controlUi: {
      enabled: true,
      basePath: "/openclaw"
    },
    
    // 认证
    // ⚠️ v2026.3.31 Breaking: trusted-proxy 模式现在拒绝混合 shared-token 配置，
    //    本地直连 fallback 也必须携带配置的 token（不再隐式认证同主机调用者）
    auth: {
      mode: "token",      // "token" | "none"
      token: ""           // 留空则自动生成
      // allowTailscale: true
    },
    
    // 远程访问 (可选)
    // remote: {
    //   url: "ws://gateway.tailnet:18789",
    //   token: "remote-token"
    // },
    
    // WebChat 配置 (v2026.4.1+)
    // webchat: {
    //   chatHistoryMaxChars: 50000  // 聊天历史文本截断字符数 (也可通过 per-request maxChars 覆盖)
    // },

    // 配置热重载
    reload: {
      mode: "hybrid",     // "hybrid" | "hot" | "restart" | "off"
      debounceMs: 1000
    },
    // HTTP 安全响应头 (v2026.2.21+, 公网暴露时使用)
    // http: {
    //   securityHeaders: {
    //     "Strict-Transport-Security": "max-age=31536000",
    //     "X-Content-Type-Options": "nosniff",
    //     "X-Frame-Options": "DENY"
    //   }
    // },
  },

  // --------------------------------------------------------------------------
  // 十、日志配置
  // --------------------------------------------------------------------------
  logging: {
    level: "info",        // "debug" | "info" | "warn" | "error"
    file: "/tmp/openclaw/openclaw.log",  // 实际文件名带日期: openclaw-YYYY-MM-DD.log
    consoleLevel: "info",
    consoleStyle: "pretty",  // "pretty" | "compact" | "json"
    redactSensitive: "tools"  // "off" | "tools"
  },

  // --------------------------------------------------------------------------
  // 十一、命令配置
  // --------------------------------------------------------------------------
  commands: {
    // 原生命令 (Telegram/Discord 菜单命令)
    native: "auto",  // "auto" | true | false
    
    // 文本命令解析
    text: true,
    
    // Bash 命令 (危险，需要 elevated 权限)
    bash: false,
    bashForegroundMs: 2000,
    
    // 配置命令
    config: false,
    
    // 调试命令
    debug: false,
    
    // 重启命令
    restart: false,
    
    // 使用访问组
    useAccessGroups: true
  },

  // --------------------------------------------------------------------------
  // 十二、技能配置 (可选)
  // --------------------------------------------------------------------------
  skills: {
    // 允许的内置技能
    allowBundled: ["gemini", "peekaboo"],
    
    // 加载配置
    load: {
      // 额外技能目录
      // extraDirs: ["~/Projects/agent-scripts/skills"]
    },
    
    // 安装配置
    install: {
      preferBrew: true,
      nodeManager: "bun"
    }
    
    // 技能条目配置
    // entries: {
    //   "skill-name": {
    //     enabled: true,
    //     apiKey: "...",
    //     env: { KEY: "value" }
    //   }
    // }
  },

  // --------------------------------------------------------------------------
  // 十三、自定义模型提供商 (可选)
  // --------------------------------------------------------------------------
  models: {
    // 模式: "merge" | "replace"
    mode: "merge",
    
    providers: {
      // 自定义代理示例
      // "custom-proxy": {
      //   baseUrl: "http://localhost:4000/v1",
      //   apiKey: "YOUR_KEY",
      //   api: "openai-responses",
      //   authHeader: true,
      //   models: [
      //     {
      //       id: "llama-3.1-8b",
      //       name: "Llama 3.1 8B",
      //       reasoning: false,
      //       input: ["text"],
      //       cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
      //       contextWindow: 128000,
      //       maxTokens: 32000
      //     }
      //   ]
      // },
      // Ollama / vLLM / SGLang (v2026.3.12: 迁移到 provider-plugin 架构)
      // 安装: openclaw plugins install ollama
      // 支持 provider-owned onboarding、模型发现和 model-picker setup
      // "ollama": {
      //   baseUrl: "http://localhost:11434",
      //   models: [{ id: "llama3.3", name: "Llama 3.3" }]
      // },
      // LM Studio (v2026.4.12+, bundled provider)
      // 本地 OpenAI 兼容模型，含 onboarding、运行时模型发现、stream preload、memory-search embedding
      // "lmstudio": {
      //   baseUrl: "http://localhost:1234",
      //   models: [{ id: "local-model", name: "My Local Model" }]
      // },
      // Kilo Gateway (多模型网关)
      // "kilo": {
      //   baseUrl: "https://api.kilo.ai/v1",
      //   apiKey: "${KILO_API_KEY}",
      //   api: "openai",
      //   models: [{ id: "kilo-router", name: "Kilo Router" }]
      // },
      // Moonshot AI / Kimi (月之暗面)
      // "moonshot": {
      //   baseUrl: "https://api.moonshot.cn/v1",
      //   apiKey: "${MOONSHOT_API_KEY}",
      //   api: "openai",
      //   models: [{ id: "moonshot-v1-128k", name: "Moonshot v1 128K" }]
      // },
      // MiniMax (v2026.3.2+, v2026.3.28: only M2.7 retained, image-01 added)
      // "minimax": {
      //   baseUrl: "https://api.minimaxi.chat/v1",
      //   apiKey: "${MINIMAX_API_KEY}",
      //   api: "openai",
      //   models: ["MiniMax-M2.7", "image-01"]
      // },
    }
  },

  // --------------------------------------------------------------------------
  // 十四、消息路由 (多 Agent 场景)
  // --------------------------------------------------------------------------
  bindings: [
    // 路由规则示例
    // {
    //   agentId: "personal",
    //   match: { channel: "whatsapp", accountId: "default" }
    // },
    // {
    //   agentId: "work",
    //   match: { channel: "whatsapp", accountId: "business" }
    // },
    // {
    //   agentId: "family",
    //   match: { channel: "whatsapp", peer: { kind: "group", id: "family-group-id" } }
    // }
  ],

  // --------------------------------------------------------------------------
  // 十五、定时任务 (可选)
  // --------------------------------------------------------------------------
  cron: {
    enabled: false,
    store: "~/.openclaw/cron/cron.json",
    maxConcurrentRuns: 2
    // 单任务 Webhook 投递 (可选)
    // delivery: { mode: "webhook", url: "https://example.com/hook" },
    // ⚠️ v2026.3.11 breaking: cron 不再支持 ad hoc agent send 或 fallback main-session 通知
    // 升级后运行 openclaw doctor --fix 迁移旧 cron 存储和投递元数据
  },

  // --------------------------------------------------------------------------
  // 十六、Webhook (可选)
  // --------------------------------------------------------------------------
  hooks: {
    // ========== 内置 Hooks ==========
    internal: {
      enabled: true,
      entries: {
        "boot-md": { enabled: true },           // 启动时加载 boot.md
        "command-logger": { enabled: true },     // 记录命令执行日志
        "session-memory": { enabled: true }      // 会话记忆持久化
      }
    },

    // ========== 外部 Webhook (可选) ==========
    // enabled: false,
    // path: "/hooks",
    // token: "",
    // defaultSessionKey: "hooks",
    // allowRequestSessionKey: true,
    // allowedSessionKeyPrefixes: ["ci-"],
    // presets: ["gmail"],
    // transformsDir: "~/.openclaw/hooks",
    // mappings: [
    //   {
    //     match: { source: "github", event: "push" },
    //     action: "message",
    //     agentId: "dev",
    //     deliver: { channel: "telegram", peer: "123456789" }
    //   }
    // ]
  },

  // --------------------------------------------------------------------------
  // 十六(b)、插件配置 (可选, 需要重启)
  // --------------------------------------------------------------------------
  // ⚠️ v2026.3.12 安全变更: 工作区插件不再自动加载
  // 克隆的仓库中的插件代码需要显式信任才能执行 (GHSA-99qw-6mr3-36qr)
  // plugins: {
  //   list: [
  //     { id: "my-plugin", enabled: true }
  //   ],
  //   // 插件级配置 (v2026.3.7+)
  //   // entries: {
  //   //   "my-plugin": {
  //   //     hooks: {
  //   //       allowPromptInjection: false,  // 是否允许插件修改 before_agent_start 提示词
  //   //       // requireApproval: true    // v2026.3.28: before_tool_call 审批 (Telegram/Discord/CLI)
  //   //       // before_agent_reply: true // v2026.4.2: inline action 后合成回复短路 LLM
  //   //     },
  //   //     prependSystemContext: "Plugin guidance prepended to system prompt",
  //   //     appendSystemContext: "Plugin guidance appended to system prompt",
  //   //     // Context Engine 插件插槽 (v2026.3.7+)
  //   //     // 提供替代上下文管理策略 (如 lossless-claw)
  //   //     // contextEngine: true
  //   //   },
  //   //   // v2026.3.28: 搜索 provider 配置迁移到插件
  //   //   "perplexity": {
  //   //     enabled: true,
  //   //     config: {
  //   //       webSearch: { model: "sonar-pro" }
  //   //     }
  //   //   },
  //   //   // v2026.4.2: Firecrawl web_fetch 从 tools.web.fetch.firecrawl 迁移到此处
  //   //   "firecrawl": {
  //   //     config: {
  //   //       webFetch: {
  //   //         enabled: false,
  //   //         apiKey: { "$secret": "FIRECRAWL_API_KEY" },
  //   //         onlyMainContent: true,
  //   //         timeoutSeconds: 60,
  //   //       }
  //   //     }
  //   //   },
  //   //   // v2026.4.2: xAI x_search 从 tools.web.x_search 迁移到此处
  //   //   "xai": {
  //   //     config: {
  //   //       xSearch: { /* x_search 设置 */ },
  //   //       webSearch: { apiKey: { "$secret": "XAI_API_KEY" } }
  //   //     }
  //   //   },
  //   //   // ========== Active Memory (v2026.4.10+) ==========
  //   //   // 可选记忆子代理: 回复前自动拉取相关偏好/上下文/历史
  //   //   // 文档: https://docs.openclaw.ai/concepts/active-memory
  //   //   "active-memory": {
  //   //     enabled: false,
  //   //     config: {
  //   //       mode: "recent",       // "message" | "recent" | "full"
  //   //       // 高级: prompt/thinking 覆盖、transcript 持久化等
  //   //     }
  //   //   },
  //   //   // ========== 记忆梦境 (实验性, v2026.4.5+) ==========
  //   //   // memory-core 内置插件的后台记忆整合系统
  //   //   // 三阶段: Light (采集候选) → Deep (评分提升到 MEMORY.md) → REM (提取模式)
  //   //   // 产出: memory/.dreams/ (机器状态), DREAMS.md (人类可读), MEMORY.md (长期提升)
  //   //   // 聊天命令: /dreaming status|on|off|help
  //   //   // CLI: openclaw memory promote [--apply], promote-explain, rem-harness
  //   //   "memory-core": {
  //   //     config: {
  //   //       dreaming: {
  //   //         enabled: true,
  //   //         frequency: "0 3 * * *",        // cron 表达式 (默认每天凌晨 3 点)
  //   //         // v2026.4.15+: storage.mode 默认从 "inline" 改为 "separate"
  //   //         //   separate: phase 块写到 memory/dreaming/{light,rem}/YYYY-MM-DD.md
  //   //         //   inline:   phase 块注入到每日 memory/YYYY-MM-DD.md (旧行为)
  //   //         // storage: { mode: "separate" }
  //   //       }
  //   //     }
  //   //   }
  //   // }
  // },

  // 自动更新 (v2026.2.22+, 默认关闭)
  // update: {
  //   auto: { enabled: false, channel: "stable", intervalHours: 24 }
  // },

  // --------------------------------------------------------------------------
  // 十七、安全配置 (v2026.2.24+)
  // --------------------------------------------------------------------------
  // security: {
  //   trust_model: {
  //     // 多用户检测启发式 (v2026.2.24+)
  //     // 检测到多用户共享同一实例时发出警告
  //     // 多用户场景建议: sandbox.mode="all", 工作区隔离, 限制工具权限
  //     multi_user_heuristic: true
  //   }
  // },

  // Talk Mode 语音对话 (v2026.3.8+)
  // talk: {
  //   silenceTimeoutMs: 1500,  // 静默多久后自动发送当前转录（毫秒）
  //                            // 未设置时使用各平台默认值
  //   voiceWake: false          // macOS Voice Wake — 语音唤醒触发 Talk Mode (v2026.4.1+)
  // },

  // Agent Communication Protocol (ACP)
  // "acp": {
  //   "dispatch": {
  //     "enabled": true  // Default: true since v2026.3.2
  //   },
  //   // ACP 来源追踪 (v2026.3.8+)
  //   // CLI: openclaw acp --provenance off|meta|meta+receipt
  //   // resumeSessionId: "session-uuid"  // 恢复已有 ACP 会话 (v2026.3.11+)
  // },

  // --------------------------------------------------------------------------
  // 十八、浏览器工具 (全局开关)
  // --------------------------------------------------------------------------
  browser: {
    enabled: true     // 启用浏览器工具
    // Chrome 自定义启动参数 (可选)
    // extraArgs: ["--disable-gpu", "--no-sandbox"],
    // 更多选项见官方文档: https://docs.openclaw.ai/tools/browser

    // 浏览器配置文件 (v2026.3.13+)
    // defaultProfile: "openclaw",  // 默认使用的 profile: "openclaw" | "user" | "chrome-relay"
    // profiles: {
    //   // Chrome DevTools MCP 附着模式 — 使用已登录的 Chrome 会话
    //   // 需要 Chrome 144+, 启用 chrome://inspect/#remote-debugging
    //   // user: {
    //   //   driver: "existing-session",
    //   //   attachOnly: true,      // 不启动新浏览器，仅附着到已运行的
    //   // },
    //   // 自定义 userDataDir (Brave/Edge 等 Chromium 浏览器, v2026.3.22+)
    //   // "brave": {
    //   //   driver: "existing-session",
    //   //   userDataDir: "/path/to/BraveSoftware/Brave-Browser/User Data"
    //   // },
    // }
  }
}
